{% extends "base.html.twig" %}
{% block title %} login {% endblock %}

{% block body %}
<form action="/login" method="POST">
    <input type="hidden" name="_token" value="{{ csrf_token_value }}">

    <div class="container">
        <div class="header">
            <h2>📚 Login page</h2>
        </div>

        {% if error_messages %}
            <div id="error-text">
                {% for error in error_messages %}
                    ⚠️ {{ error }}
                    {% if not loop.last %}<br>{% endif %}
                {% endfor %}
            </div>
        {% endif %}

        <div class="diary-form-group">
            <div class="diary-form-label">
                <h3>ID</h3>
            </div>
            <div class="diary-form-label">
                <input type='text' name='username' required/>
            </div>
        </div>

        <div class="diary-form-group">
            <div class="diary-form-label">
                <h3>password</h3>
            </div>
            <div >
                <input type='password' name='password' required/>
            </div>
        </div>

        <div class="btn-container">
            <button type="submit" class="btn">Login</button>
            <button type="submit" form="sign-up" class="btn">Create Account</button>
        </div>
    </div>
</form>

<form id="sign-up" action="/signup" method="POST">
    <input type="hidden" name="_method">
    <input type="hidden" name="_token" value="{{ csrf_token_value }}">
</form>
{% endblock %}