{
    "name": "aoyagi/aoyagi-diary",
    "description": "aoyagi-diary composer",
    "autoload": {
        "psr-4": {
            "Aoyagi\\AoyagiDiary\\": "src/",
            "Aoyagi\\AoyagiDiary\\Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aoyagi\\AoyagiDiary\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "aoyagi"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.6@dev",
        "php-di/php-di": "dev-master"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3@dev"
    },
    "scripts": {
        "migrate" : "php scripts/init_db.php"
    }
}
